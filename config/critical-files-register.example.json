{
  "version": "1.0-core",
  "documentId": "SPEI-FIM-CFR-CORE-001",
  "scope": "core-windows-workstation-pilot",
  "approvedBy": "SPEI Information Security Officer",
  "approvalDate": "2026-05-22",
  "reviewDueDate": "2027-05-22",
  "notes": "Minimal pilot scope for core Windows workstation FIM. Database manager paths are intentionally not enabled in this core template; add product-specific DB manager configuration paths before formal compliance rollout.",
  "items": [
    {
      "id": "OS-CORE-001",
      "enabled": true,
      "path": "%WINDIR%\\System32\\drivers\\etc\\hosts",
      "type": "file",
      "category": "operating_system",
      "recursive": false,
      "maxDepth": 0,
      "maxFilesPerItem": 1,
      "maxFileSizeMB": 10,
      "excludePatterns": [],
      "hash": true,
      "acl": true,
      "auditCorrelation": true,
      "severity": "high",
      "rationale": "Core name resolution security configuration."
    },
    {
      "id": "OS-CORE-002",
      "enabled": true,
      "path": "%WINDIR%\\System32\\Tasks",
      "type": "directory",
      "category": "operating_system",
      "recursive": true,
      "maxDepth": 4,
      "maxFilesPerItem": 750,
      "maxFileSizeMB": 10,
      "excludePatterns": [],
      "hash": true,
      "acl": true,
      "auditCorrelation": true,
      "severity": "high",
      "rationale": "Scheduled task definitions are a core persistence control point."
    },
    {
      "id": "OS-CORE-003",
      "enabled": true,
      "path": "%ProgramData%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup",
      "type": "directory",
      "category": "operating_system",
      "recursive": true,
      "maxDepth": 2,
      "maxFilesPerItem": 100,
      "maxFileSizeMB": 10,
      "excludePatterns": [],
      "hash": true,
      "acl": true,
      "auditCorrelation": true,
      "severity": "high",
      "rationale": "Machine-wide startup location is a core persistence control point."
    },
    {
      "id": "FIM-CORE-001",
      "enabled": true,
      "path": "C:\\Program Files\\SPEI-FIM",
      "type": "directory",
      "category": "fim_tool",
      "recursive": true,
      "maxDepth": 6,
      "maxFilesPerItem": 250,
      "maxFileSizeMB": 20,
      "excludePatterns": [],
      "hash": true,
      "acl": true,
      "auditCorrelation": true,
      "severity": "critical",
      "rationale": "FIM tool scripts must be monitored for integrity."
    },
    {
      "id": "FIM-CORE-002",
      "enabled": true,
      "path": "C:\\ProgramData\\SPEI-FIM\\Config",
      "type": "directory",
      "category": "fim_tool",
      "recursive": true,
      "maxDepth": 3,
      "maxFilesPerItem": 100,
      "maxFileSizeMB": 10,
      "excludePatterns": [
        "*\\efk-token.protected"
      ],
      "hash": true,
      "acl": true,
      "auditCorrelation": true,
      "severity": "critical",
      "rationale": "FIM configuration and monitored-file register must be monitored."
    }
  ]
}
