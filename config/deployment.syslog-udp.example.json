{
  "assetId": "AUTO-COMPUTERNAME",
  "environment": "production",
  "scanIntervalHours": 12,
  "logRetentionDaysLocal": 180,
  "logMaxSizeMB": 1024,
  "auditCorrelationLookbackMinutes": 900,
  "executionPolicyForTask": "Bypass",
  "initialChangeTicket": "CHG-CHANGE-ME",
  "criticalFilesRegisterPath": "",
  "clearPlaintextTokenAfterInstall": true,
  "auditPolicy": {
    "enableFileSystem": true,
    "enableHandleManipulation": false,
    "enableProcessCreation": false
  },
  "efk": {
    "enabled": true,
    "mode": "syslog",
    "filebeatServiceName": "filebeat",
    "filebeatReadPrincipal": "",
    "endpoint": "",
    "syslogHost": "EFK_SYSLOG_IP_CHANGE_ME",
    "syslogPort": 5140,
    "syslogProtocol": "udp",
    "syslogFacility": "local0",
    "syslogAppName": "SPEI-FIM",
    "syslogFraming": "newline",
    "authTokenPlainText": "",
    "timeoutSeconds": 15,
    "tlsSkipCertificateCheck": false
  }
}
